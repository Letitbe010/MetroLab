{
  "name": "metrolab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MetroLab: dimensional metrology exercise trainer (instrument readings, gauge blocks, sine bar, tapers, three-wire method, rollers, temperature, limit gauges) for the Basque OPE 1508 (Fabrikazio Mekanikoaren Antolamendua eta Proiektuak)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "oracle": "vitest run tests/oracle.test.ts",
    "oracle:py": "python tools/oracle/oracle.py tools/oracle/out/oracle.json tests/golden/golden.json",
    "icons": "node tools/make-icons.mjs",
    "usability": "node tools/usability.mjs http://localhost:4193/MetroLab/",
    "a11y": "node tools/a11y.mjs http://localhost:4193/MetroLab/"
  },
  "dependencies": {
    "@types/katex": "^0.16.7",
    "katex": "^0.16.11",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "^4.10.2",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "fast-check": "3.23.2",
    "globals": "15.14.0",
    "playwright-core": "^1.49.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.6",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "3.0.5"
  }
}
